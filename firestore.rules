rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null &&
          (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    match /friendRequests/{requestId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid;
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);
    }

    match /chats/{chatId} {
      allow read, update: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;

      // Each message denormalizes `participants` onto itself rather than
      // relying on get()-ing the parent chat doc: on the first message of a
      // brand-new chat, the chat doc and the message are created in the same
      // batch, and rules evaluate each write against the pre-batch state — a
      // get() here would see the parent doc as not-yet-existing and deny the
      // write. Checking the message's own resource data avoids that entirely.
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in resource.data.participants;
        allow create: if request.auth != null &&
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
